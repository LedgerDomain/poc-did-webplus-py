FROM python:3.12-slim

WORKDIR /app

# Install uv for fast installs
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Docker CLI for sibling `docker run` via socket mount (docker-cli, not docker.io —
# on Debian trixie the client is a separate package; docker.io is daemon-only).
RUN apt-get update && apt-get install -y --no-install-recommends docker-cli ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy project files (build context is repo root)
COPY pyproject.toml ./
COPY did_webplus/ ./did_webplus/
COPY interop/resolvers.py interop/run_test_vectors.py interop/run_interop_tests.py ./interop/

# Install the package (no dev deps)
RUN uv sync --no-dev

ENTRYPOINT ["uv", "run", "python", "interop/run_test_vectors.py"]
